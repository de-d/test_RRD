<h1 class="form__title">Создание заявки на доставку</h1>

<%= form_with model: @order, local: true, html: { class: "form" } do |f| %>
  <div class="form__grid">
    <% [
      [:first_name, "Имя"],
      [:last_name, "Фамилия"],
      [:middle_name, "Отчество"],
      [:phone, "Телефон"],
      [:email, "Email"],
      [:weight, "Вес (кг)"],
      [:length, "Длина (см)"],
      [:width, "Ширина (см)"],
      [:height, "Высота (см)"],
      [:from, "Пункт отправления (город)"],
      [:to, "Пункт назначения (город)"]
    ].each do |field, label_text| %>
      <div class="form__field">
        <%= f.label field, label_text, class: "form__label" %>
        <%= f.text_field field, class: "form__input", required: true %>
      </div>
    <% end %>
  </div>

  <div class="form__actions">
    <%= f.submit "Рассчитать доставку и сохранить", class: "form__submit" %>
  </div>
<% end %>
